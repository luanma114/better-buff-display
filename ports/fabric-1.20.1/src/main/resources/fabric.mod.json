{
  "schemaVersion": 1,
  "id": "bufflist",
  "version": "${version}",
  "name": "Better Buff Display",
  "description": "Shows your active effects as a list with names, levels, timers and descriptions. Client-side.",
  "authors": ["luanma114"],
  "license": "MIT",
  "icon": "assets/bufflist/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.bufflist.fabric.BuffListFabric"],
    "modmenu": ["com.bufflist.fabric.ModMenuCompat"]
  },
  "mixins": ["bufflist.mixins.json"],
  "depends": {
    "fabricloader": ">=0.14.21",
    "minecraft": "~1.20.1",
    "fabric-api": "*",
    "java": ">=17"
  }
}
